# Leave both blank to run in demo mode (in-memory data, no backend needed).
# Fill them in to store everything in Supabase Postgres.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only used by `npm run gc` (the storage cleanup script). Never commit this,
# and never put it in a VITE_ variable — it must not reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
